# Copy this file to .env for local development.
# Keep every real value private. The repository intentionally ships no API keys,
# provider endpoints, local node addresses or machine-specific paths.

ELEVENLABS_API_KEY=
# Volcengine Doubao Speech / Doubao-Seed-TTS 2.0 / Doubao-Seed-ICL 2.0
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_VOICE_TYPE=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOICEBOX_URL=
SEEDANCE_PYTHON=
TOOL_VAULT_PATH=
SEEDANCE_RUNNER=
SEEDANCE_MODEL=

# 短剧工作台：编排 LLM（OpenAI 兼容端点；不配置则使用本机演示编排）
DRAMA_LLM_BASE_URL=
DRAMA_LLM_MODEL=
DRAMA_LLM_API_KEY=
# 短剧工作台：本机 ComfyUI（Flux 首帧生成）
COMFYUI_URL=
# 短剧预算单价校准（人民币，预估）
DRAMA_PRICE_SEEDANCE_PER_SHOT=6
DRAMA_PRICE_H3_PER_SECOND=0.5
DRAMA_PRICE_TTS_PER_KCHAR=2

# 短剧工作台：剧情镜视频工作流模板（ComfyUI 导出的 API 格式 JSON）
DRAMA_VIDEO_WORKFLOW=
COMFYUI_VIDEO_TIMEOUT_MS=
